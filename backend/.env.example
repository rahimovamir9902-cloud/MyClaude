# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file or share your API key.

# Your Claude (Anthropic) API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxx

# Which Claude model to use. claude-haiku-4-5 is fast and cheap and works
# great for a tutoring chat. Use claude-sonnet-5 for higher quality.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Port the server listens on.
PORT=8787

# Comma-separated list of allowed origins for CORS. Use * only in development.
ALLOWED_ORIGINS=*
